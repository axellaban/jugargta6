# Dominio que apunta (registro A) a la IP pública del VPS. Caddy saca el certificado.
STREAM_DOMAIN=stream.tudominio.com
PUBLIC_IP=203.0.113.10

# URL pública de la web (Vercel). MediaMTX valida publish/read contra /api/stream/auth.
APP_URL=https://tu-app.vercel.app

# coturn (TURN REST API con credenciales efímeras). Mismo valor que TURN_STATIC_AUTH_SECRET en apps/web.
TURN_REALM=stream.tudominio.com
TURN_STATIC_AUTH_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
