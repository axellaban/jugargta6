# =============================================================================
# apps/web — variables de entorno (copiá a apps/web/.env.local o cargalas en Vercel)
# =============================================================================

# --- Sitio --------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=JugarGTA6
# URL pública (sin barra final). En Vercel se deduce de VERCEL_PROJECT_PRODUCTION_URL si falta.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...               # o NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...                   # o SUPABASE_SECRET_KEY=sb_secret_...  (solo servidor)

# --- Modo de stream -------------------------------------------------------------
# SIMULATED: Fase 1 (stream de referencia + turnos de práctica). REAL: Fase 2 (consola).
STREAM_MODE=SIMULATED
# Consola de la Fase 2: ps5 (Chiaki-ng) | xbox (Greenlight). Define qué botones se bloquean.
CONSOLE_PROFILE=ps5

# --- Pagos ------------------------------------------------------------------------
# mock: registra la intención y muestra "todavía no cobramos" (no se cobra nada).
CHECKOUT_PROVIDER=mock
MOCK_CURRENCY=ARS

# Mercado Pago (Tus integraciones → Credenciales). Webhook: {APP_URL}/api/webhooks/mercadopago, evento "Pagos".
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=ARS

# Stripe. Webhook: {APP_URL}/api/webhooks/stripe con checkout.session.* y charge.refunded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=USD

# Precios opcionales (JSON) para testear disposición a pagar sin tocar código.
# PRODUCT_PRICES={"skip_queue":{"ARS":3000,"USD":3.49},"extend_10":{"ARS":2000},"vip_turn":{"ARS":4500}}
PRODUCT_PRICES=

# --- Fase 2: consola real (dejar vacío en Fase 1) ---------------------------------
# Secreto compartido con bridge/ (BRIDGE_SHARED_SECRET). Mínimo 32 caracteres: openssl rand -hex 32
BRIDGE_SHARED_SECRET=
BRIDGE_PUBLIC_URL=wss://bridge.tudominio.com/control
# MediaMTX (infra/mediamtx). El jugador activo lee por WHEP con un token firmado.
WHEP_URL=https://stream.tudominio.com/console1/whep
STREAM_TOKEN_SECRET=                               # por defecto usa BRIDGE_SHARED_SECRET
STREAM_PUBLISH_SECRET=                             # Bearer token que configurás en OBS (WHIP)
STREAM_PUBLIC_HLS=0                                # 1 = espectadores pueden leer LL-HLS de MediaMTX
TURN_URLS=stun:stream.tudominio.com:3478,turn:stream.tudominio.com:3478?transport=udp,turn:stream.tudominio.com:3478?transport=tcp
TURN_STATIC_AUTH_SECRET=                           # igual que en infra/mediamtx/.env
