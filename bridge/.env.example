# Mismo valor que BRIDGE_SHARED_SECRET en apps/web (mínimo 32 caracteres).
BRIDGE_SHARED_SECRET=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
# vgamepad (Windows + ViGEmBus) | log (imprime los inputs) | null
BRIDGE_BACKEND=log
# ds4 = DualShock 4 virtual (Chiaki-ng / PS5) | x360 = Xbox 360 virtual (Greenlight / Xbox)
BRIDGE_TARGET=ds4
# Perfil anti-troll: ps5 bloquea PS y Create/Share; xbox bloquea Guide. Options/Menu solo con toque corto.
BRIDGE_PROFILE=ps5
BRIDGE_HOLD_LIMIT_MS=800
BRIDGE_IDLE_TIMEOUT_MS=500
BRIDGE_MAX_RATE=250
# Origen de la web (bloquea conexiones desde otros sitios). Separados por coma.
BRIDGE_ALLOWED_ORIGINS=https://tu-app.vercel.app,http://localhost:3000
# Botones extra a bloquear (nombres de packages/protocol): p.ej. Touchpad
BRIDGE_EXTRA_BLOCKED=
